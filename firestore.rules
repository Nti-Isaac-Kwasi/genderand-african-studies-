rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAuthenticated() { return request.auth != null; }

    function isValidUserProfileCreate(data) {
      return data.keys().hasAll(['displayName', 'createdAt']) &&
             data.keys().size() >= 2 && data.keys().size() <= 4 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.createdAt == request.time &&
             (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!data.keys().hasAny(['highestScore']) || (data.highestScore is number));
    }
    
    function isValidUserProfileUpdate(data) {
      return (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100)) &&
             (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!data.keys().hasAny(['highestScore']) || (data.highestScore is number));
    }

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;

      allow create: if isAuthenticated() && isValidId(userId) && request.auth.uid == userId && isValidUserProfileCreate(incoming());
      allow update: if isAuthenticated() && isValidId(userId) && request.auth.uid == userId && 
                    isValidUserProfileUpdate(incoming()) && 
                    (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'highestScore']));
    }

    function isValidQuizResultCreate(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'totalQuestions', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.score is number && data.score >= 0 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.createdAt == request.time;
    }

    match /leaderboard/{resultId} {
      allow get: if isValidId(resultId);
      allow list: if true;

      allow create: if isAuthenticated() && isValidId(resultId) && isValidQuizResultCreate(incoming()) &&
                    exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update, delete: if false;
    }
  }
}
